#include <iostream>
#include <string>

using namespace std;

class Insan {
protected: 
    string ad;
    int yas;
    int id;

public: 
    Insan(string a, int y, int i) {
        ad = a;
        yas = y;
        id = i;
    }

    void yazdir() {
        cout << "Ad: " << ad << "\nYas: " << yas << "\nID: " << id << endl;
    }
};

class Ogrenci : public Insan {
private: 
    string bolum;

public:
    Ogrenci(string a, int y, int i, string b) : Insan(a, y, i) {
        bolum = b;
    }

    void yazdir() {
        cout << "--- Ogrenci Bilgileri ---" << endl;
        Insan::yazdir();
        cout << "Bolum: " << bolum << endl;
    }

    void dersKayit(string ders) {
        cout << "-> " << ad << " adli ogrenci " << ders << " dersine kayit oldu." << endl;
    }
};

class Calisan : public Insan {
private:
    double maas;

public:
    Calisan(string a, int y, int i, double m) : Insan(a, y, i) {
        maas = m;
    }

    void yazdir() {
        cout << "--- Calisan Bilgileri ---" << endl;
        Insan::yazdir();
        cout << "Maas: " << maas << " TL" << endl;
    }

    void zamHesapla(double oran) {
        maas += maas * (oran / 100);
        cout << "-> " << ad << " adli calisana %" << oran << " zam yapildi. Yeni maas: " << maas << " TL" << endl;
    }
};

int main() {
    Ogrenci ogr("Süleyman", 21, 1045, "Bilgisayar Muhendisligi");
    ogr.yazdir();
    ogr.dersKayit("Nesne Yonelimli Programlama");

    cout << "\n=================================\n\n";

    Calisan cls("Ahmet", 35, 2088, 35000.0);
    cls.yazdir();
    cls.zamHesapla(15.0);

    return 0;


}

